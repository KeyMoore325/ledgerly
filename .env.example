# Optional: enables Claude-powered advice on the Planner page.
# Without it, the app still works using its built-in rule-based suggestions.
ANTHROPIC_API_KEY=
# Public URL used for SEO metadata, sitemap and RSS links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: turns on email + password accounts (Supabase).
# Find both in your Supabase dashboard → Project Settings → API Keys.
# Without them, the app runs in guest mode and saves budgets in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
